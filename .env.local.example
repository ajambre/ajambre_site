# =============================================================================
# AJAMBRE SITE — exemplo de variáveis de ambiente
# =============================================================================
# Copie para .env.local e preencha os valores.
# NUNCA faça commit de .env.local nem escreva valores reais neste arquivo.
# =============================================================================

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.ajambre.com.br

# --- Tracking / Mensuração ---------------------------------------------------
# Somente o container do Google Tag Manager.
#
# GA4, Meta Pixel e Google Ads são configurados DENTRO do GTM — não como scripts
# separados no código. Isso evita disparo duplicado de pageview e de conversão,
# e mantém um único ponto de controle para consentimento.
#
# Formato: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# --- Contato -----------------------------------------------------------------
# Número oficial de WhatsApp ainda NÃO confirmado (somente dígitos, ex: 5511999999999)
NEXT_PUBLIC_WHATSAPP=

# --- Supabase (site institucional) -------------------------------------------
# Projeto próprio do site. Não reutilizar credenciais do LeadBase
# nem do Business Scanner / Business Intelligence.
# A service_role NUNCA deve ser exposta ao client (sem prefixo NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
